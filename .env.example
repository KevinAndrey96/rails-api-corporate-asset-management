# Copy to .env and fill in. Never commit the real .env file.

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Keep false for plain HTTP on localhost; set true behind an HTTPS proxy.
RAILS_FORCE_SSL=false
APP_PORT=3000

# Editor token registered on the first boot (minimum 32 characters). Generate with: openssl rand -base64 32
# Leave empty and issue tokens later with: docker compose exec api bin/rails "api_clients:issue[name,editor]"
BOOTSTRAP_API_TOKEN=

# Load the fictional demo employees, assets and assignments when the database is empty.
LOAD_DEMO_DATA=true
